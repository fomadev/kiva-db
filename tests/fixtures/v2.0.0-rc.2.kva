# A KivaDB 2.0.0-rc.2 home, for the compatibility test of the next versions
# (tests/compat_rc2.rs). Made once by the published rc.2 executable:
#   kivadb --home <home> --no-listen run tests/fixtures/v2.0.0-rc.2.kva
# then the paths of kiva.conf replaced by @HOME@. Never changed afterwards.
changes enable retain 87600h
set greeting "hello"
set n:count 41
set flag true
set date born "2004-05-09"
set datetime created_at "2026-10-27T14:30:00Z"
set time opens "08:00"
set session:abc "token" ttl 315360000
set user:1 {"name": "Ana", "role": "dev", "age": 31, "city": "Goma", "joined": "2026-01-15"}
set user:2 {"name": "Ben", "role": "ops", "age": 45, "city": "Bukavu", "joined": "2025-06-02"}
set user:3 {"name": "Chloe", "role": "dev", "age": 27, "city": "Goma", "joined": "2026-03-30"}
create index on user: (role)
create index on user:*.city using hash
create unique index on user: (name) ignore case
changes read from beginning as search limit 4
set order:1 {"total": "1250.50", "created_at": "2026-10-01T09:00:00Z", "day": "2026-10-01"}
set order:2 {"total": "80.25", "created_at": "2026-10-02T10:30:00Z", "day": "2026-10-02"}
del n:count
set doc:1 {"title": "first", "embedding": [1.0, 0.0, 0.0]}
set doc:2 {"title": "second", "embedding": [0.0, 1.0, 0.0]}
set doc:3 {"title": "third", "embedding": [0.7, 0.7, 0.0]}
create vector index on doc: (embedding) using hnsw
project create travel
workspace create travel.places
workspace switch travel.places
schema set place: {"name": {"type": "string", "required": true}, "opens": {"type": "time"}, "kind": {"enum": ["hotel", "park"], "default": "park"}}
set place:1 {"name": "Virunga", "opens": "07:30"}
set place:2 {"name": "Serena", "opens": "00:00", "kind": "hotel"}
workspace create travel.cache
workspace switch travel.cache
set hit:1 "cached"
workspace switch default
create user "app" identified by "app-pw" grant write on travel.* default workspace travel.places
create user "guest" identified by "guest-pw" role viewer grant read on travel.places
